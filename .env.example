# OPTIONAL for local development. If this file is missing, the app still
# works: the Vite dev server proxies every /api request to the backend at
# http://127.0.0.1:3001 automatically.
#
# Copy this file to ".env" in this same folder only when you need it:
#
#   Windows (PowerShell, run inside the frontend folder):
#       copy .env.example .env
#   macOS / Linux:
#       cp .env.example .env

# Leave EMPTY for local development (uses the Vite proxy).
# Set to the deployed backend URL (e.g. https://your-server.example.com)
# only for production builds that talk to a remote API.
VITE_API_URL=

# Firebase web configuration. These are public client identifiers (they are
# shipped to the browser), not secrets. The current UI logs in through the
# Node backend (admin@primepower.com / admin123), so these values are only
# needed if Firebase authentication is re-enabled in the code.
VITE_FIREBASE_API_KEY=AIzaSyCGMCoYbA0nPm4eVee397MNiRaa_5Aupfc
VITE_FIREBASE_AUTH_DOMAIN=primepower-finance-management.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=primepower-finance-management
VITE_FIREBASE_STORAGE_BUCKET=primepower-finance-management.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=14269863775
VITE_FIREBASE_APP_ID=1:14269863775:web:89c2773e8fbe95ada108ea
